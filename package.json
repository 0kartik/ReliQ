{
  "name": "reliablequeue",
  "version": "1.0.0",
  "type": "module",
  "main": "src/gateway/server.js",
  "scripts": {
    "gateway": "node src/gateway/server.js",
    "worker": "node src/worker/worker.js",
    "scheduler": "node src/retry/scheduler.js",
    "reaper": "node src/reaper/reaper.js",
    "loadgen": "node scripts/loadgen.js",
    "lint": "eslint src scripts",
    "format": "prettier --write .",
    "test": "node --test tests/",
    "dev": "concurrently -n GATEWAY,WORKER,SCHEDULER,REAPER,LOADGEN -c blue,green,yellow,magenta,cyan \"npm:gateway\" \"npm:worker\" \"npm:scheduler\" \"npm:reaper\" \"npm:loadgen\"",
    "demo": "concurrently -n GATEWAY,WORKER,SCHEDULER,REAPER -c blue,green,yellow,magenta \"npm:gateway\" \"npm:worker\" \"npm:scheduler\" \"npm:reaper\""
  },
  "dependencies": {
